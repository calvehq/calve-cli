{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "calve pack verify --json",
  "description": "The `data` of the v1 envelope {\"api_version\":\"1\",\"command\",\"data\"}. Additional properties may appear within v1.",
  "schema": {
    "type": "object",
    "properties": {
      "candidate": {
        "type": "string"
      },
      "config": {
        "type": "object",
        "properties": {
          "digest": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "required": []
      },
      "digest": {
        "type": "string"
      },
      "extension": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "manifest_digest": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "manifest_digest",
          "version"
        ]
      },
      "findings": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ]
        }
      },
      "finished_at": {
        "type": "string"
      },
      "generation": {
        "type": "integer"
      },
      "id": {
        "type": "string"
      },
      "pack": {
        "type": "string"
      },
      "provenance": {
        "type": "object",
        "properties": {
          "caller": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "runtime_instance": {
            "type": "string"
          }
        },
        "required": [
          "caller",
          "request_id",
          "runtime_instance"
        ]
      },
      "started_at": {
        "type": "string"
      },
      "status": {
        "type": "string"
      },
      "verifier": {
        "type": "string"
      }
    },
    "required": [
      "candidate",
      "config",
      "digest",
      "extension",
      "finished_at",
      "generation",
      "id",
      "pack",
      "provenance",
      "started_at",
      "status",
      "verifier"
    ]
  }
}
