{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "calve materialize rollback --json",
  "description": "The `data` of the v1 envelope {\"api_version\":\"1\",\"command\",\"data\"}, generated from its response type (calve-api `responses`).",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "MaterializeRolledBack",
    "description": "`calve materialize rollback`.",
    "type": "object",
    "properties": {
      "op": {
        "type": "string"
      },
      "state": {
        "$ref": "#/$defs/MaterializeState"
      },
      "reverted": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "additionalProperties": false,
    "required": [
      "op",
      "state",
      "reverted"
    ],
    "$defs": {
      "MaterializeState": {
        "description": "State of a materialization operation (§14).",
        "oneOf": [
          {
            "type": "string",
            "enum": [
              "Completed",
              "RolledBack"
            ]
          },
          {
            "description": "Steps remain, or provenance is not recorded yet: `calve materialize resume`.",
            "type": "string",
            "const": "Interrupted"
          },
          {
            "description": "A step found unexpected content: `calve materialize resolve`.",
            "type": "string",
            "const": "Conflicted"
          }
        ]
      }
    }
  }
}
