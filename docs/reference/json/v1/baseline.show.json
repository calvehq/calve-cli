{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "calve baseline show --json",
  "description": "The `data` of the v1 envelope {\"api_version\":\"1\",\"command\",\"data\"}. Additional properties may appear within v1.",
  "schema": {
    "type": "object",
    "properties": {
      "canonical": {
        "type": "string"
      },
      "digest": {
        "type": "string"
      },
      "envelope": {
        "type": "object",
        "properties": {
          "body": {
            "type": "object",
            "properties": {
              "facts": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer"
                }
              },
              "graph_digest": {
                "type": "string"
              },
              "heads": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "id": {
                "type": "string"
              },
              "members": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "facts",
              "graph_digest",
              "heads",
              "id",
              "members"
            ]
          },
          "created_seq": {
            "type": "integer"
          },
          "creator": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "namespace": {
            "type": "string"
          },
          "protocol_version": {
            "type": "string"
          }
        },
        "required": [
          "body",
          "created_seq",
          "creator",
          "id",
          "kind",
          "namespace",
          "protocol_version"
        ]
      }
    },
    "required": [
      "canonical",
      "digest",
      "envelope"
    ]
  }
}
