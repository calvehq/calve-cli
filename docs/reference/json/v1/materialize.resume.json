{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "calve materialize resume --json",
  "description": "The `data` of the v1 envelope {\"api_version\":\"1\",\"command\",\"data\"}, generated from its response type (calve-api `responses`).",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "MaterializeCompleted",
    "description": "`calve materialize resume` / `resolve`: the operation driven to `Completed`.",
    "type": "object",
    "properties": {
      "op": {
        "type": "string"
      },
      "state": {
        "$ref": "#/$defs/MaterializeState"
      },
      "execution": {
        "description": "The OpenAEVC execution holding the provenance observations.",
        "type": "string"
      },
      "provenance_pack": {
        "type": "string"
      },
      "written": {
        "description": "Paths of the planned steps.",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "primitives": {
        "description": "`linux-renameat2` or `fallback`.",
        "type": "string"
      },
      "resolved": {
        "description": "`resolve` only: paths whose conflict was resolved.",
        "type": [
          "array",
          "null"
        ],
        "items": {
          "type": "string"
        }
      }
    },
    "additionalProperties": false,
    "required": [
      "op",
      "state",
      "execution",
      "provenance_pack",
      "written",
      "primitives"
    ],
    "$defs": {
      "MaterializeState": {
        "description": "State of a materialization operation (§14).",
        "oneOf": [
          {
            "type": "string",
            "enum": [
              "Completed",
              "RolledBack"
            ]
          },
          {
            "description": "Steps remain, or provenance is not recorded yet: `calve materialize resume`.",
            "type": "string",
            "const": "Interrupted"
          },
          {
            "description": "A step found unexpected content: `calve materialize resolve`.",
            "type": "string",
            "const": "Conflicted"
          }
        ]
      }
    }
  }
}
