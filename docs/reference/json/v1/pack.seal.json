{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "calve pack seal --json",
  "description": "The `data` of the v1 envelope {\"api_version\":\"1\",\"command\",\"data\"}. Additional properties may appear within v1.",
  "schema": {
    "type": "object",
    "properties": {
      "active_executions": {
        "type": "array",
        "items": {}
      },
      "blockers": {
        "type": "array",
        "items": {}
      },
      "can_seal": {
        "type": "boolean"
      },
      "candidate": {
        "type": "object",
        "properties": {
          "changes": {
            "type": "object",
            "properties": {
              "snapshot": {
                "type": "integer"
              }
            },
            "required": []
          },
          "effects": {
            "type": "integer"
          }
        },
        "required": [
          "changes",
          "effects"
        ]
      },
      "candidate_digest": {
        "type": "string"
      },
      "generation": {
        "type": "integer"
      },
      "incomplete_captures": {
        "type": "array",
        "items": {}
      },
      "missing_extensions": {
        "type": "array",
        "items": {}
      },
      "note": {
        "type": "string"
      },
      "pack": {
        "type": "string"
      },
      "policies": {
        "type": "array",
        "items": {}
      },
      "state": {
        "type": "string"
      },
      "unresolved_task_dependencies": {
        "type": "array",
        "items": {}
      }
    },
    "required": []
  }
