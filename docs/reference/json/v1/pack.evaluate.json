{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "calve pack evaluate --json",
  "description": "The `data` of the v1 envelope {\"api_version\":\"1\",\"command\",\"data\"}. Additional properties may appear within v1.",
  "schema": {
    "type": "object",
    "properties": {
      "candidate": {
        "type": "string"
      },
      "config": {
        "type": "object",
        "properties": {
          "warn_after_files": {
            "type": "integer"
          }
        },
        "required": [
          "warn_after_files"
        ]
      },
      "digest": {
        "type": "string"
      },
      "evaluator": {
        "type": "string"
      },
      "extension": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "manifest_digest": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "manifest_digest",
          "version"
        ]
      },
      "finished_at": {
        "type": "string"
      },
      "generation": {
        "type": "integer"
      },
      "id": {
        "type": "string"
      },
      "metrics": {
        "type": "object",
        "additionalProperties": {
          "type": "integer"
        }
      },
      "pack": {
        "type": "string"
      },
      "provenance": {
        "type": "object",
        "properties": {
          "caller": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "runtime_instance": {
            "type": "string"
          }
        },
        "required": [
          "caller",
          "request_id",
          "runtime_instance"
        ]
      },
      "started_at": {
        "type": "string"
      },
      "verdict": {
        "type": "string"
      }
    },
    "required": [
      "candidate",
      "config",
      "digest",
      "evaluator",
      "extension",
      "finished_at",
      "generation",
      "id",
      "metrics",
      "pack",
      "provenance",
      "started_at",
      "verdict"
    ]
  }
}
