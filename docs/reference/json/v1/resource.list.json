{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "calve resource list --json",
  "description": "The `data` of the v1 envelope {\"api_version\":\"1\",\"command\",\"data\"}. Additional properties may appear within v1.",
  "schema": {
    "type": "array",
    "items": {
      "type": "object",
      "properties": {
        "captureable": {
          "type": "boolean"
        },
        "digest": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "pack": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "size": {
          "type": "integer"
        },
        "value": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ]
        }
      },
      "required": [
        "kind"
      ]
    }
  }
}
